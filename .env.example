# =============================================================================
# AI 专利编写平台 — 环境变量模板
#
# 复制本文件为 .env.local（本地开发）或 .env（Docker / 生产），按需填写。
#
# 最小可用配置：只需要 DATABASE_URL + SETTINGS_ENCRYPTION_KEY，
# 然后在浏览器里访问站点完成初始化，再到「管理后台 → AI 服务配置」里
# 图形化地添加模型 API —— 那种方式更推荐，不需要改这个文件。
#
# 如果你希望「配好文件就能跑」而不进后台点，则把下面的 AI 变量也填上。
# =============================================================================

# -----------------------------------------------------------------------------
# 数据库（必填）
# -----------------------------------------------------------------------------
# PostgreSQL 连接串。用 docker-compose 启动时会自动注入，无需手填。
# 云端数据库（如阿里云 RDS、腾讯云、Supabase）请把地址换成对应实例。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patent_agent

# 云端数据库通常要求 SSL，置为 true 可在证书自签名时也能连通
DATABASE_SSL=false

# 连接池上限
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# 密钥加密（强烈建议配置）
# -----------------------------------------------------------------------------
# 用于加密存储用户填写的模型 API Key（AES-256-GCM）。
# 生成方式：openssl rand -base64 32
# 注意：一旦设置就不要再改，改了会导致已保存的密钥无法解密。
SETTINGS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 对话模型（可选 —— 不填也可以，改用管理后台图形化配置）
# -----------------------------------------------------------------------------
# 任何 OpenAI 兼容服务均可：OpenAI / DeepSeek / 通义千问 / Kimi / 智谱 /
# 硅基流动 / OpenRouter / 本地 Ollama / vLLM ...
# 注意：baseURL 填到版本号为止，不要带 /chat/completions
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=

# -----------------------------------------------------------------------------
# 联网搜索（可选）
# -----------------------------------------------------------------------------
# 专利生成需要检索 50 篇文献、审查需要查法规依据，建议配置。
#   tavily  —— 国际通用，https://tavily.com
#   bocha   —— 博查，国内可直连，https://open.bochaai.com
#   searxng —— 自建元搜索，零 API 费用，需自行部署并开启 format=json
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# 自建 SearXNG 时填实例地址，例如 http://searxng:8080
SEARCH_BASE_URL=

# -----------------------------------------------------------------------------
# 图像生成（可选，用于专利附图）
# -----------------------------------------------------------------------------
# 任何兼容 /images/generations 的服务均可。
# 如：OpenAI gpt-image-1 / dall-e-3、智谱 cogview-4、硅基流动 Kwai-Kolors/Kolors
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# -----------------------------------------------------------------------------
# 应用配置
# -----------------------------------------------------------------------------
# 生产环境务必设为 production
NODE_ENV=production

# 服务端口
PORT=5000

# 用反向代理 / 自定义域名做开发联调时，追加允许的 dev origin（逗号分隔）
# 例如：ALLOWED_DEV_ORIGINS=*.example.com,localhost:3000
ALLOWED_DEV_ORIGINS=

# 构建 standalone 产物（Dockerfile 会自动设置为 true）
NEXT_OUTPUT_STANDALONE=
