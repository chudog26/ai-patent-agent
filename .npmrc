# 依赖源。国内直连更快；海外部署或遇到同步延迟时，
# 可注释掉下面这行回退官方源，或用环境变量临时覆盖：
#   npm_config_registry=https://registry.npmjs.org pnpm install
registry=https://registry.npmmirror.com

# 网络优化
network-concurrency=16
fetch-retries=3
fetch-timeout=60000
# 注意：这里刻意不设 loglevel=error。pnpm 在「解析完成、开始下载」阶段
# 会长时间不输出，看起来像卡死；保留默认日志级别可以看到下载进度。

# 依赖包的存放位置（store）。默认会按「项目所在磁盘」自动选择，
# 首次安装需要下载全部依赖；如果你在另一块盘上已有 pnpm 缓存，可显式复用：
#   store-dir=D:\.pnpm-store
# store-dir=

# Next.js / React 19 生态里 peer 依赖提示很多，关掉避免噪音
strict-peer-dependencies=false
auto-install-peers=true

# lockfile
lockfile=true
prefer-frozen-lockfile=true
resolution-mode=highest
